global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    project: regiobuild
    env: production

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/alert_rules.yml

scrape_configs:
  - job_name: regiobuild-api
    metrics_path: /metrics
    static_configs:
      - targets: ["api:3000"]
        labels:
          service: api

# Grafana Cloud — URL/user/token подставляются при старте контейнера из .env
remote_write:
  - url: ${GRAFANA_CLOUD_PROMETHEUS_URL}
    basic_auth:
      username: ${GRAFANA_CLOUD_PROMETHEUS_USER}
      password: ${GRAFANA_CLOUD_PROMETHEUS_TOKEN}
    write_relabel_configs:
      - source_labels: [__name__]
        regex: ".*"
        action: keep
